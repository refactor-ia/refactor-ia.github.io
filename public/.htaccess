ErrorDocument 404 /404.html

# Static site: disable directory listings
Options -Indexes

# Send www to the apex (active once the www certificate is issued)
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} =www.refactoria.dev [NC]
RewriteRule ^ https://refactoria.dev%{REQUEST_URI} [R=301,L]
</IfModule>
