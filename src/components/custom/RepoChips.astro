---
import Button from "@/components/Button.astro";
import { GITHUB_ACTIVITY, activeRepos } from "@/data/activity.ts";

interface Props {
  /** Maximum number of repos, busiest first. */
  limit?: number;
}

const { limit = 6 } = Astro.props;
const repos = activeRepos(GITHUB_ACTIVITY, limit);
---

<div class="repo-chips_wrap">
  {
    repos.map((repo) => (
      <Button
        element="link"
        variant="link"
        href={repo.href}
        class="mono-label"
        rel="noopener"
      >
        {repo.repo}
      </Button>
    ))
  }
</div>

<style is:global>
  @layer components {
    .repo-chips_wrap {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
      margin-block: var(--space-5);
    }
  }
</style>
