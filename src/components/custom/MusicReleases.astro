---
import Button from "@/components/Button.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Icon from "@/components/Media/Icon.astro";
import play from "@/assets/icons/play.svg";

interface Release {
  kind: string;
  title: string;
  url: string;
  cover: string;
  alt: string;
}

const releases: Release[] = [
  {
    kind: "Single",
    title: "P(DOOM)",
    url: "https://open.spotify.com/artist/22Udt5YIZaGRDuGVfSN03w",
    cover: "/favicon-512.png",
    alt: "Logo de RefactorIA: la barba en blanco sobre violeta",
  },
  {
    kind: "Álbum",
    title: "RefactorIA",
    url: "https://open.spotify.com/album/3RBxTEy92zSYDZNuctzUXh",
    cover: "/music/refactoria-album.jpg",
    alt: "Tapa del álbum RefactorIA",
  },
];
---

<div class="releases_grid">
  {
    releases.map((release) => (
      <a
        class="release_wrap"
        href={release.url}
        rel="noopener"
        aria-label={`Escuchar ${release.title} en Spotify`}
      >
        <span class="release_cover_wrap">
          <img
            class="release_cover"
            src={release.cover}
            alt={release.alt}
            width="112"
            height="112"
            loading="lazy"
          />
          <span class="release_play" aria-hidden="true">
            <Icon src={play} variant="small" />
          </span>
        </span>
        <span class="release_info">
          <Eyebrow tag="span" variant="tag">
            {release.kind}
          </Eyebrow>
          <span class="release_title">{release.title}</span>
          <span class="release_listen mono-label">Escuchar en Spotify</span>
        </span>
      </a>
    ))
  }
</div>
<div class="releases_platforms">
  <Button
    element="link"
    href="https://music.apple.com/us/artist/refactoria/6811690240"
    class="mono-label"
    rel="noopener"
  >
    Apple Music
  </Button>
  <Button
    element="link"
    href="https://www.youtube.com/channel/UCqDys5rhEVdb2_Of2ZeHMEw"
    class="mono-label"
    rel="noopener"
  >
    YouTube Music
  </Button>
</div>
<p class="releases_note">
  Los próximos lanzamientos se anuncian primero en Discord.
</p>

<script>
  const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (fine && !reduce) {
    document.querySelectorAll<HTMLElement>(".release_wrap").forEach((card) => {
      const cover = card.querySelector<HTMLElement>(".release_cover");
      if (!cover) return;

      card.addEventListener("pointermove", (ev) => {
        const pointer = ev as PointerEvent;
        const rect = card.getBoundingClientRect();
        card.style.setProperty("--spot-x", `${pointer.clientX - rect.left}px`);
        card.style.setProperty("--spot-y", `${pointer.clientY - rect.top}px`);

        /* Tilt the cover a few degrees towards the pointer. */
        const dx = (pointer.clientX - rect.left) / rect.width - 0.5;
        const dy = (pointer.clientY - rect.top) / rect.height - 0.5;
        cover.style.transform = `perspective(40rem) rotateY(${dx * 8}deg) rotateX(${dy * -8}deg) scale(1.04)`;
      });

      card.addEventListener("pointerleave", () => {
        cover.style.transform = "";
      });
    });
  }
</script>

<style is:global>
  @layer components {
    .releases_grid {
      display: grid;
      gap: var(--space-4);
      width: 100%;
    }

    @media (width >= 44rem) {
      .releases_grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    .release_wrap {
      position: relative;
      display: flex;
      align-items: center;
      gap: var(--space-4);
      overflow: hidden;
      padding: var(--space-4);
      background-color: var(--background-2);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-small);
      text-decoration: none;
      transition:
        transform var(--hover-duration) var(--hover-ease),
        border-color var(--hover-duration) var(--hover-ease),
        box-shadow var(--hover-duration) var(--hover-ease);
    }

    .release_wrap::after {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(
        20rem circle at var(--spot-x, 50%) var(--spot-y, 50%),
        color-mix(in srgb, var(--brand-500) 16%, transparent),
        transparent 45%
      );
      opacity: 0;
      transition: opacity var(--hover-duration) var(--hover-ease);
      pointer-events: none;
    }

    .release_cover_wrap {
      position: relative;
      flex: none;
      width: 7rem;
      height: 7rem;
      border-radius: calc(var(--radius-small) - 0.125rem);
      overflow: hidden;
    }

    .release_cover {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 240ms var(--hover-ease);
    }

    .release_play {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      color: #fff;
      background: color-mix(in srgb, var(--canvas, #0b0714) 55%, transparent);
      opacity: 0;
      transition: opacity var(--hover-duration) var(--hover-ease);
    }

    .release_play :global(.icon_wrap) {
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      border: var(--border-width) solid currentcolor;
      border-radius: var(--radius-round);
    }

    .release_info {
      display: grid;
      justify-items: start;
      gap: var(--space-2);
      min-width: 0;
    }

    .release_title {
      color: var(--text);
      font-size: clamp(1.4rem, 3vw, 1.9rem);
      font-weight: var(--primary-bold);
      letter-spacing: var(--letter-spacing-tight);
      line-height: var(--line-height-small);
    }

    .release_listen {
      color: var(--text-2);
      font-size: var(--text-small, 0.85rem);
      transition: color var(--hover-duration) var(--hover-ease);
    }

    .releases_platforms {
      display: flex;
      flex-wrap: wrap;
      justify-content: var(--_alignment, flex-start);
      gap: var(--space-3);
      margin-top: var(--space-2);
    }

    .releases_note {
      margin: var(--space-4) 0 0;
      color: var(--text-2);
      font-size: var(--text-small, 0.9rem);
      text-align: var(--_alignment, start);
    }

    @media (hover: hover) {
      .release_wrap:hover {
        transform: translateY(-0.1875rem);
        border-color: color-mix(in srgb, var(--brand-500) 65%, transparent);
        box-shadow:
          0 0 0 1px color-mix(in srgb, var(--brand-500) 30%, transparent),
          0 16px 36px -18px
            color-mix(in srgb, var(--brand-500) 45%, transparent);
      }

      .release_wrap:hover::after {
        opacity: 1;
      }

      .release_wrap:hover .release_play {
        opacity: 1;
      }

      .release_wrap:hover .release_listen {
        color: color-mix(in srgb, var(--brand-500), white 30%);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .release_cover {
        transition: none;
        transform: none !important;
      }
    }
  }
</style>
