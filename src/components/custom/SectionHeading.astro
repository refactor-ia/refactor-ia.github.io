---
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Heading from "@/components/Typography/Heading.astro";

interface Props {
  /** Small label shown above the title. */
  eyebrow: string;
  /** Section title text. */
  title: string;
  /** Center the heading block. */
  centered?: boolean;
}

const { eyebrow, title, centered = false } = Astro.props;
---

<div class:list={["section-head_wrap", centered && "centered"]}>
  <Eyebrow class="mono-label">{eyebrow}</Eyebrow>
  <Heading tag="h2" variant="h2">{title}</Heading>
</div>

<style is:global>
  @layer components {
    .section-head_wrap {
      display: grid;
      gap: var(--space-3);
      justify-items: start;
      margin-bottom: var(--space-6);
    }

    .section-head_wrap.centered {
      justify-items: center;
      text-align: center;
    }
  }
</style>
