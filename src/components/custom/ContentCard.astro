---
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import { slotContent } from "@/utils/slots.ts";

interface Props {
  /** Card title. */
  title: string;
  /** Where the whole card links to. Omitted renders a plain card. */
  href?: string;
}

const { title, href } = Astro.props;
const description = await slotContent(Astro.slots);
const Tag = href ? "a" : "article";
---

<Tag
  class:list={["content-card_wrap", href && "linked"]}
  href={href}
  rel={href ? "noopener" : undefined}
>
  <Heading tag="h3" variant="h3">{title}</Heading>
  <Paragraph>{description}</Paragraph>
</Tag>

<script>
  if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
    document
      .querySelectorAll<HTMLElement>(".content-card_wrap")
      .forEach((card) => {
        card.addEventListener("pointermove", (ev) => {
          const rect = card.getBoundingClientRect();
          card.style.setProperty("--spot-x", `${ev.clientX - rect.left}px`);
          card.style.setProperty("--spot-y", `${ev.clientY - rect.top}px`);
        });
      });
  }
</script>

<style is:global>
  @layer components {
    .content-card_wrap {
      position: relative;
      display: grid;
      align-content: start;
      gap: var(--space-3);
      padding: var(--space-5);
      background-color: var(--background-2);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-small);
      text-decoration: none;
      overflow: hidden;
      transition:
        transform var(--duration-card) var(--ease-out-expo),
        border-color var(--duration-card) var(--ease-out-expo),
        box-shadow var(--duration-card) var(--ease-out-expo);
    }

    .content-card_wrap::after {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(
        22rem circle at var(--spot-x, 50%) var(--spot-y, 50%),
        color-mix(in srgb, var(--brand-500) 14%, transparent),
        transparent 45%
      );
      opacity: 0;
      transition: opacity var(--duration-card) var(--ease-out-expo);
      pointer-events: none;
    }

    @media (hover: hover) and (pointer: fine) {
      .content-card_wrap:hover::after {
        opacity: 1;
      }
    }

    .content-card_wrap > :global(*) {
      position: relative;
      z-index: 1;
    }

    .content-card_wrap.linked {
      @media (hover: hover) {
        &:hover {
          transform: translateY(calc(var(--lift-md) * -1));
          border-color: color-mix(in srgb, var(--brand-500) 65%, transparent);
          box-shadow: var(--glow-md);
        }
      }
      &:active {
        transform: scale(var(--press-scale));
        transition-duration: var(--duration-press);
      }
      @media (prefers-reduced-motion: reduce) {
        &:hover,
        &:active {
          transform: none;
        }
      }
    }

    .content-card_wrap :global(.heading_wrap) {
      color: var(--text);
    }
  }
</style>
