---
import Grid from "@/components/Wrapper/Grid.astro";
---

/** Responsive card grid built on the Lumos Grid: one column on small * screens,
two from 30rem, three from 64rem. Cards inside get a pointer * spotlight. */ ---

<div class="cardgrid_layout">
  <Grid variant="columns" small={2} medium={2} large={3}>
    <slot />
  </Grid>
</div>

<script>
  const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

  if (fine) {
    document.querySelectorAll(".cardgrid_layout").forEach((grid) => {
      grid.addEventListener("pointermove", (ev) => {
        const pointer = ev as PointerEvent;
        const card = (pointer.target as HTMLElement).closest<HTMLElement>(
          ".content-card_wrap",
        );
        if (!card) return;
        const rect = card.getBoundingClientRect();
        card.style.setProperty("--spot-x", `${pointer.clientX - rect.left}px`);
        card.style.setProperty("--spot-y", `${pointer.clientY - rect.top}px`);
      });
    });
  }
</script>

<style is:global>
  @layer components {
    .cardgrid_layout {
      width: 100%;
    }
  }
</style>
