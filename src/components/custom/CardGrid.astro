---
/** Responsive grid for content cards: one column on small screens, two on
 * mid sizes, three from 64rem up. Cards inside get a pointer spotlight. */
---

<div class="cardgrid_layout">
  <slot />
</div>

<script>
  const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

  if (fine) {
    document.querySelectorAll(".cardgrid_layout").forEach((grid) => {
      grid.addEventListener("pointermove", (ev) => {
        const pointer = ev as PointerEvent;
        const card = (pointer.target as HTMLElement).closest<HTMLElement>(
          ".content-card_wrap",
        );
        if (!card) return;
        const rect = card.getBoundingClientRect();
        card.style.setProperty("--spot-x", `${pointer.clientX - rect.left}px`);
        card.style.setProperty("--spot-y", `${pointer.clientY - rect.top}px`);
      });
    });
  }
</script>

<style is:global>
  @layer components {
    .cardgrid_layout {
      display: grid;
      gap: var(--space-4);
    }

    @media (width >= 44rem) {
      .cardgrid_layout {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (width >= 64rem) {
      .cardgrid_layout {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }
  }
</style>
