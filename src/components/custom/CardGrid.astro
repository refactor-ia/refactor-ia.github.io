---
/** Responsive grid for content cards: one column on small screens, two on
 * mid sizes, three from 64rem up. */
---

<div class="cardgrid_layout">
  <slot />
</div>

<style is:global>
  @layer components {
    .cardgrid_layout {
      display: grid;
      gap: var(--space-4);
    }

    @media (width >= 44rem) {
      .cardgrid_layout {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (width >= 64rem) {
      .cardgrid_layout {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }
  }
</style>
