---
import Section from "@/components/Wrapper/Section.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import logoBraille from "@/assets/generated/logo-braille.txt?raw";

const typedPhrase = "Modernize with engineering judgment.";
const beardRows = logoBraille.split("\n").filter((line) => line.length > 0);
---

<Section id="hero" paddingTop="even" paddingBottom="even">
  <ContentWrapper variant="columns">
    <div class="hero-intro_wrap">
      <Eyebrow class="mono-label"
        >Migraciones. IA. Criterio. En español.</Eyebrow
      >
      <Heading tag="h1" variant="display">RefactorIA</Heading>
      <p class="hero-motto mono-label" aria-label={`${typedPhrase} No hype.`}>
        <span
          class="hero-motto_typed"
          data-text={typedPhrase}
          aria-hidden="true">{typedPhrase}</span
        >
        <span class="hero-motto_accent" aria-hidden="true">No hype.</span>
      </p>
      <Paragraph variant="large">
        Software real, en producción. Hablamos de lo que funciona, lo que no y
        qué hacer con eso.
      </Paragraph>
      <ButtonWrapper>
        <Button
          element="link"
          href="https://discord.gg/D3PhJ477Bj"
          rel="noopener"
        >
          Entrar al Discord
        </Button>
        <Button
          element="link"
          emphasis="secondary"
          href="https://github.com/refactor-ia"
          rel="noopener"
        >
          Ver proyectos
        </Button>
        <Button
          element="link"
          emphasis="secondary"
          href="https://www.youtube.com/@RefactorIA"
          rel="noopener"
        >
          Mirar contenido
        </Button>
      </ButtonWrapper>
    </div>
    <pre
      class="hero-beard"
      slot="column2"
      aria-hidden="true">{
      beardRows.map((row, index) => (
        <span class="hero-beard_row" style={`--row-index: ${index}`}>{row + "\n"}</span>
      ))
    }</pre>
  </ContentWrapper>
</Section>

<script>
  const motto = document.querySelector<HTMLElement>(".hero-motto");
  const typed = document.querySelector<HTMLElement>(".hero-motto_typed");
  const art = document.querySelector<HTMLElement>(".hero-beard");

  /* Typing effect for the motto. */
  if (motto && typed) {
    const reduce = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (!reduce) {
      motto.classList.add("is-typing");
      const full = typed.dataset.text ?? "";
      typed.textContent = "";
      let index = 0;
      const tick = () => {
        typed.textContent = full.slice(0, index++);
        if (index <= full.length) {
          setTimeout(tick, 26);
        } else {
          motto.classList.remove("is-typing");
        }
      };
      setTimeout(tick, 350);
    }
  }

  /* Fit the braille logo to its column: measure at a reference size, then
   * scale the font so the widest row fills the container exactly once. */
  const fitBeard = () => {
    if (!art || !art.parentElement) return;
    art.style.fontSize = "100px";
    const scale = art.parentElement.clientWidth / art.scrollWidth;
    art.style.fontSize = `${Math.max(8, Math.floor(100 * scale * 98) / 100)}px`;
  };

  if (art) {
    fitBeard();
    window.addEventListener("resize", fitBeard, { passive: true });
    if (document.fonts?.ready) {
      document.fonts.ready.then(fitBeard);
    }
  }
</script>

<style is:global>
  @layer components {
    .hero-intro_wrap {
      display: grid;
      gap: var(--space-4);
      justify-items: start;
    }

    .hero-motto {
      margin: 0;
      color: var(--text-2);
      font-size: clamp(1rem, 2vw, 1.2rem);
      letter-spacing: 0;
    }

    .hero-motto_accent {
      color: color-mix(in srgb, var(--brand-500), white 30%);
    }

    /* While typing: hide the accent and ride a cursor rendered as a
       pseudo-element, so scrapers and screen readers never see it. */
    .hero-motto.is-typing .hero-motto_accent {
      display: none;
    }

    .hero-motto.is-typing .hero-motto_typed::after {
      content: "▌";
      margin-inline-start: 0.05em;
      color: var(--brand-500);
    }

    .hero-beard {
      margin: 0;
      overflow: hidden;
      width: 100%;
      color: var(--text);
      font-family: var(--font-mono);
      line-height: 1.12;
      letter-spacing: 0;
      text-shadow: 0 0 24px
        color-mix(in srgb, var(--brand-500) 35%, transparent);
    }

    .hero-beard_row {
      display: block;
      opacity: 0;
      transform: translateY(0.25em);
      animation: hero-beard-reveal 480ms var(--hover-ease) forwards;
      animation-delay: calc(var(--row-index) * 55ms + 250ms);
    }

    @keyframes hero-beard-reveal {
      to {
        opacity: 0.95;
        transform: translateY(0);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .hero-beard_row {
        opacity: 0.95;
        transform: none;
        animation: none;
      }
    }
  }
</style>
