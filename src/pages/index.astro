---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Wrapper/Section.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import SectionHeroMain from "@/components/custom/SectionHeroMain.astro";
import MarqueeTopics from "@/components/custom/MarqueeTopics.astro";
import SectionHeading from "@/components/custom/SectionHeading.astro";
import ContentStack from "@/components/custom/ContentStack.astro";
import CardGrid from "@/components/custom/CardGrid.astro";
import ContentCard from "@/components/custom/ContentCard.astro";
import MusicReleases from "@/components/custom/MusicReleases.astro";
import EmailCopy from "@/components/custom/EmailCopy.astro";
import IdentityList from "@/components/custom/IdentityList.astro";
import RepoChips from "@/components/custom/RepoChips.astro";
import ActivityFeed from "@/components/custom/ActivityFeed.astro";
import VideoList from "@/components/custom/VideoList.astro";
import { SAME_AS, href } from "@/data/links.ts";

const roles = [
  {
    title: "Maintainer de Gentle AI",
    org: "Gentle AI",
    href: "https://github.com/Gentleman-Programming/gentle-ai",
    badge:
      "https://raw.githubusercontent.com/Gentleman-Programming/gentle-ai/main/docs/assets/brand/built-with-gentle-ai.png",
    alt: "Built with Gentle-AI",
    width: 220,
  },
  {
    title: "Embajador de NaN.Builders",
    org: "NaN.Builders",
    href: "https://nan.builders",
    badge: "https://nan.builders/badge/built-with-nan-dark.svg",
    alt: "Built with NaN",
    width: 266,
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://refactoria.dev/#organization",
      name: "RefactorIA",
      url: "https://refactoria.dev/",
      email: "juan@refactoria.dev",
      logo: "https://refactoria.dev/favicon-512.png",
      description:
        "Comunidad en español de software, arquitectura, modernización e inteligencia artificial aplicada al desarrollo.",
      founder: { "@id": "https://refactoria.dev/#juan-barbat" },
      sameAs: SAME_AS,
    },
    {
      "@type": "Person",
      "@id": "https://refactoria.dev/#juan-barbat",
      name: "Juan Barbat",
      url: href("github-personal"),
      jobTitle: "Creador y responsable de RefactorIA",
      worksFor: { "@id": "https://refactoria.dev/#organization" },
      affiliation: roles.map((role) => ({
        "@type": "Organization",
        name: role.org,
        url: role.href,
      })),
    },
    {
      "@type": "WebSite",
      "@id": "https://refactoria.dev/#website",
      url: "https://refactoria.dev/",
      name: "RefactorIA",
      inLanguage: "es",
      publisher: { "@id": "https://refactoria.dev/#organization" },
    },
  ],
};

const playlist = (id: string) => `https://www.youtube.com/playlist?list=${id}`;

const channels = [
  {
    title: "RefactorIA Devs",
    href: href("youtube-devs"),
    playlists: [
      {
        title: "IA para desarrolladores",
        id: "PLHyE1_ybzabU",
        description:
          "Cómo meter IA en el flujo de trabajo sin perder el criterio.",
      },
      {
        title: "Agentes IA",
        id: "PLYyKFx_ubmcw",
        description:
          "Agentes de código en proyectos reales: qué hacen bien y dónde fallan.",
      },
      {
        title: "Arquitectura",
        id: "PLXgZYNWTtTNE",
        description:
          "Decisiones de diseño, trade-offs y lo que deja el software que sobrevive.",
      },
      {
        title: "Saliendo de Windev",
        id: "PLX7ElcrG0UU4",
        description:
          "La migración desde PC Soft hacia un stack moderno, paso a paso.",
      },
      {
        title: "Devlogs",
        id: "PLFbfYOblJt3U",
        description:
          "Bitácora de lo que estamos construyendo, con lo que sale mal incluido.",
      },
      {
        title: "Open Build Room: NaN.Builders y Gentle-AI",
        id: "PLP3wgshSph74",
        description: "Construcción en abierto junto a otras comunidades.",
      },
    ],
  },
  {
    title: "RefactorIA Labs",
    href: href("youtube-labs"),
    playlists: [
      {
        title: "Labs",
        id: "PLT1Ea8AGLC80c70voLUC2FeJVWwdr-z2D",
        description: "Streams y experimentos largos construyendo en vivo.",
      },
      {
        title: "Open Build Room",
        id: "PLT1Ea8AGLC83z2BRh0oLHecNUkDoV4H7l",
        description: "Sesiones abiertas de construcción, en vivo y sin editar.",
      },
      {
        title: "Talleres",
        id: "PLT1Ea8AGLC81mbvCnyusRsspD0czfemoi",
        description: "Sesiones prácticas para hacer, no solo mirar.",
      },
    ],
  },
];
---

<Layout
  theme="dark"
  title="RefactorIA | Modernize with engineering judgment. No hype."
  description="RefactorIA es una comunidad en español de software, arquitectura, modernización e inteligencia artificial aplicada al desarrollo. Experiencia real, sistemas en producción y open source. Creada y dirigida por Juan Barbat."
  jsonLd={jsonLd}
>
  <SectionHeroMain />

  <MarqueeTopics />

  <Section id="que-es">
    <ContentWrapper variant="columns">
      <SectionHeading
        eyebrow="Qué es RefactorIA"
        title="Criterio de ingeniería, no ruido."
      />
      <div class="prose-stack_wrap" slot="column2">
        <Paragraph>
          RefactorIA es una comunidad en español para developers que modernizan
          sistemas de verdad: los que tienen usuarios, datos y una historia que
          no se borra con un deploy.
        </Paragraph>
        <Paragraph>
          El punto de partida es el mundo PCSoft, y el techo no existe:
          cualquier developer en transición hacia arquitecturas modernas o
          integrando IA en su flujo tiene su lugar acá.
        </Paragraph>
        <Paragraph>
          Hablamos de software engineering, arquitectura, migraciones, open
          source e IA aplicada al desarrollo. Siempre desde la experiencia de
          construir y sostener software en producción.
        </Paragraph>
        <Paragraph>
          Sin frases de marketing. Compartimos lo que probamos: qué funcionó,
          qué falló, cuánto costó y qué haríamos distinto la próxima vez.
        </Paragraph>
      </div>
    </ContentWrapper>
  </Section>

  <Section id="formatos">
    <ContentWrapper>
      <ContentStack>
        <SectionHeading
          eyebrow="Contenido"
          title="Hecho para leer, mirar y usar en tu proyecto."
        />
        {
          channels.map((channel) => (
            <div class="channel-group">
              <h3 class="channel-group_title mono-label">
                <a href={channel.href} rel="noopener">
                  {channel.title}
                </a>
              </h3>
              <CardGrid>
                {channel.playlists.map((item) => (
                  <ContentCard title={item.title} href={playlist(item.id)}>
                    {item.description}
                  </ContentCard>
                ))}
              </CardGrid>
            </div>
          ))
        }
        <VideoList limit={4} />
      </ContentStack>
    </ContentWrapper>
  </Section>

  <Section id="oss">
    <ContentWrapper>
      <ContentStack>
        <SectionHeading
          eyebrow="Open Source"
          title="Código abierto, con el proceso a la vista."
        />
        <div class="prose-stack_wrap">
          <Paragraph>
            Los proyectos de la comunidad viven en la organización{" "}
            <a class="nowrap" href={href("github-org")} rel="noopener">
              github.com/refactor-ia
            </a>: herramientas, experimentos y el código que sale de los
            streams. Sin métricas infladas: entrá, mirá el código y sacá tus
            propias conclusiones.
          </Paragraph>
        </div>
        <RepoChips />
        <ActivityFeed limit={5} />
        <ButtonWrapper>
          <Button element="link" href="/now">Ver toda la actividad</Button>
          <Button
            element="link"
            emphasis="secondary"
            href={href("github-org")}
            rel="noopener"
          >
            Ver la organización en GitHub
          </Button>
        </ButtonWrapper>
      </ContentStack>
    </ContentWrapper>
  </Section>

  <Section id="music" paddingTop="large" paddingBottom="large">
    <ContentWrapper centered>
      <ContentStack>
        <SectionHeading
          centered
          eyebrow="RefactorIA Music"
          title="El software también se canta."
        />
        <Paragraph class="text-center">
          Publicamos música original inspirada en la cultura developer: bugs,
          deploys, IA y sus contradicciones. La producción usa inteligencia
          artificial de punta a punta y lo decimos sin vueltas: es otro
          experimento de la comunidad, distribuido en las plataformas
          habituales.
        </Paragraph>
        <MusicReleases />
      </ContentStack>
    </ContentWrapper>
  </Section>

  <Section id="about">
    <ContentWrapper variant="columns">
      <div class="prose-stack_wrap">
        <SectionHeading
          eyebrow="Quién está detrás"
          title="Creada y dirigida por Juan Barbat."
        />
        <Paragraph>
          RefactorIA es una comunidad independiente creada y dirigida por{" "}
          <a href={href("github-personal")} rel="noopener">Juan Barbat</a>,
          que responde por el proyecto en todas sus plataformas: este sitio, la
          organización de GitHub, los dos canales de YouTube y RefactorIA Music.
        </Paragraph>
        <ul class="roles_wrap">
          {
            roles.map((role) => (
              <li class="roles_item">
                <span class="roles_title">{role.title}</span>
                <a href={role.href} rel="noopener">
                  <img
                    src={role.badge}
                    alt={role.alt}
                    width={role.width}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <IdentityList slot="column2" />
    </ContentWrapper>
  </Section>

  <Section id="contacto" paddingTop="large" paddingBottom="large">
    <ContentWrapper centered>
      <ContentStack>
        <SectionHeading centered eyebrow="Contacto" title="Escribinos." />
        <Paragraph class="text-center">
          Propuestas, consultas o verificación de identidad: el email oficial de
          RefactorIA es:
        </Paragraph>
        <EmailCopy email="juan@refactoria.dev" />
      </ContentStack>
    </ContentWrapper>
  </Section>
</Layout>

<style is:global>
  @layer components {
    .channel-group {
      display: grid;
      gap: var(--space-4);
      justify-self: stretch;
    }

    .channel-group_title {
      margin: 0;
      font-size: var(--text-small);
    }

    .channel-group_title a {
      color: color-mix(in srgb, var(--brand-500), white 30%);
      text-decoration: none;
      @media (hover: hover) {
        &:hover {
          text-decoration: underline;
        }
      }
    }

    .nowrap {
      white-space: nowrap;
    }

    .roles_wrap {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-5);
      margin: var(--space-2) 0 0;
      padding: 0;
      list-style: none;
    }

    .roles_item {
      display: grid;
      gap: var(--space-2);
      justify-items: start;
    }

    .roles_title {
      color: var(--text-2);
      font-size: var(--text-small);
    }

    .roles_item img {
      display: block;
      width: auto;
      height: 4rem;
      max-width: 100%;
      object-fit: contain;
      transition: filter var(--duration-hover) var(--ease-out-expo);
    }

    .roles_item a {
      @media (hover: hover) {
        &:hover img {
          filter: drop-shadow(0 0 0.75rem
              color-mix(in srgb, var(--brand-500) 55%, transparent));
        }
      }
    }

    .prose-stack_wrap {
      display: grid;
      gap: var(--space-4);
      max-width: 40rem;
    }

    .prose-stack_wrap :global(a) {
      color: color-mix(in srgb, var(--brand-500), white 30%);
      text-decoration-thickness: var(--border-width);
      text-underline-offset: 0.2em;
      transition: color var(--duration-hover) var(--ease-out-expo);
      @media (hover: hover) {
        &:hover {
          color: color-mix(in srgb, var(--brand-500), white 55%);
        }
      }
    }
  }
</style>
