---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 | RefactorIA"
  description="La página que buscás no está disponible."
  canonicalPath="/404"
>
  <main class="not-found shell">
    <p class="eyebrow">Error 404</p>
    <h1>Error 404: esta ruta no está en el mapa.</h1>
    <p>Volvé al inicio para seguir la conversación.</p>
    <a class="button button-primary" href="/">Ir al inicio</a>
  </main>
</BaseLayout>
